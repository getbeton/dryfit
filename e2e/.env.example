# Beton E2E harness env. Fill in and `source` before running e2e/run_e2e.sh.
# The mason-flash3 rig keeps a populated copy at ~/.claude/secrets/mason-flash3.env.
# Never commit real values.

# ── PostHog Project B (dryfit warehouse) ──────────────────────────────
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_API_KEY=     # phc_… write key, used by dryfit_to_posthog.py /batch
POSTHOG_PERSONAL_API_KEY=    # phx_… read key, used by Inspector + posthog_dashboard.py
POSTHOG_PROJECT_ID=          # numeric, e.g. 406509

# ── Supabase (Inspector test branch) ──────────────────────────────────
# bootstrap_workspace.mjs reads SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
# The rig stores the URL as SUPABASE_BRANCH_URL; run_e2e.sh remaps it.
SUPABASE_BRANCH_URL=
SUPABASE_BRANCH_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_KEY=              # 64-char hex; MUST match Inspector's ENCRYPTION_KEY

# ── Beton / Mason (Railway + Inspector preview) ───────────────────────
INSPECTOR_URL=               # Vercel preview deploy, e.g. https://beton-inspector-git-mason-e2e-test-…vercel.app
MASON_AGENT_API_URL=         # Railway service, e.g. https://anthropic-ml-backend-mason-flash3-e2e.up.railway.app
AGENT_SECRET=                # shared secret for /api/agent/trigger-test
MASON_REPO_DIR=              # local inspector-ml-backend checkout linked to the Railway e2e service

# ── Models / tracing (set on the Mason side; here for reference) ──────
GEMINI_API_KEY=
GOOGLE_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
